# Cloud Build / Cloud Run uploads this project into a Docker build
# context. Keep source + package files; exclude only heavy/local junk.

.git
.gitignore
.DS_Store

# node_modules excluded — Cloud Build / App Engine reinstalls on the server.
node_modules/

# NOTE: dist/ is NOT excluded. App Engine standard nodejs22 no longer
# auto-runs `npm run build`, so the upload must contain prebuilt assets
# for the static_files handlers in app.yaml. Run `npm run build` locally
# before `gcloud app deploy`.

# Local-only env — secrets travel via Cloud Build substitutions, not
# files in the image.
.env
.env.local
