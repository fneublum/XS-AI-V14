# Cloud Build / Cloud Run uploads this project into a Docker build
# context. Keep source + package files; exclude only heavy/local junk.

.git
.gitignore
.DS_Store

# Build caches — Cloud Build will run `npm install` + `npm run build`
# from scratch inside the Docker image, so we don't upload local artifacts.
node_modules/
dist/

# Local-only env — secrets travel via Cloud Build substitutions, not
# files in the image.
.env
.env.local
