# Copy to .env.local and fill in values. .env.local is gitignored.
#
# Only VITE_* variables are exposed to the client bundle.
# Secrets (Gemini, ElevenLabs, etc.) must live in Supabase Edge Functions
# or GCP Secret Manager — NEVER in client-side env vars.

# Supabase (safe for client — anon key is designed for public exposure + RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Brain / HALL Supabase project (separate from the main app DB)
VITE_HALL_SUPABASE_URL=https://your-hall-project-ref.supabase.co
VITE_HALL_SUPABASE_ANON_KEY=your-hall-anon-key-here

# Optional: non-secret feature flags
# VITE_ENABLE_AI_AUTONOMY=balanced
